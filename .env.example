APP_ENV=development
HTTP_ADDR=127.0.0.1:18082
DATABASE_URL=postgres://shared_auth:shared_auth@127.0.0.1:5434/shared_auth?sslmode=disable
JWT_PRIVATE_KEY_PATH=.local/private.pem
JWT_KEY_ID=dev-key-1
JWT_ISSUER=shared-auth
VERIFICATION_HMAC_KEY=replace-with-base64-encoded-random-32-byte-value
BCRYPT_COST=12
COOKIE_SECURE=false
DEV_OUTBOX_ENABLED=true
JOBPILOT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
STUDYFLOW_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:8081,http://localhost:8081

# 本地默认使用开发收件箱；测试真实邮件时改成 resend，并关闭 DEV_OUTBOX_ENABLED。
EMAIL_PROVIDER=dev
RESEND_FROM=JobPilot & StudyFlow <verify@mail.example.com>
RESEND_API_KEY=

# 两项都留空时关闭学习路线代办令牌交换；密钥只在服务端配置。
JOBPILOT_EXCHANGE_SECRET=
STUDYFLOW_MCP_RESOURCE=
